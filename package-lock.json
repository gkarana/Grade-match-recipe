"""GradeMatch server - FastAPI.

Serves the static UI from ./static and two endpoints:
  POST /api/grade     (multipart: reference, target + params)  -> JPEG
  POST /api/ai-style  (multipart: reference, target + model)   -> PNG (via Gemini)

Run:  uvicorn main:app --host 0.0.0.0 --port 8000
"""

import base64
import io
import json

import numpy as np
from fastapi import FastAPI, Form, HTTPException, UploadFile
from fastapi.responses import Response
from fastapi.staticfiles import StaticFiles
from PIL import Image, ImageOps

import engine
import gemini

MAX_SIDE = 4000        # cap for the full-size output
ANALYSIS_SIDE = 448    # stats are computed on a small copy (grade is global)
AI_SIDE = 1024         # Gemini image models work at ~1K

app = FastAPI(title="GradeMatch API")


def _load(raw: bytes) -> np.ndarray:
    im = Image.open(io.BytesIO(raw))
    im = ImageOps.exif_transpose(im).convert("RGB")
    return np.asarray(im)


def _thumb(u8: np.ndarray, side: int) -> np.ndarray:
    h, w = u8.shape[:2]
    s = min(1.0, side / max(h, w))
    if s >= 1.0:
        return u8
    im = Image.fromarray(u8).resize(
        (max(1, round(w * s)), max(1, round(h * s))), Image.LANCZOS)
    return np.asarray(im)


def _jpeg_bytes(u8: np.ndarray, quality: int = 92) -> bytes:
    buf = io.BytesIO()
    Image.fromarray(u8).save(buf, "JPEG", quality=quality)
    return buf.getvalue()


@app.get("/healthz")
def healthz():
    return {"ok": True}


@app.post("/api/grade")
async def grade(reference: UploadFile, target: UploadFile,
                intensity: int = Form(85), tone: bool = Form(True),
                color: bool = Form(True), bands: bool = Form(True),
                clarity: int = Form(0), sharpen: int = Form(0),
                grain: int = Form(0), vibe: int = Form(0),
                warmth: int = Form(0), smoother: int = Form(0),
                glow: int = Form(0), crop: str = Form("")):
    try:
        ref_raw = _load(await reference.read())
        ref_small = _thumb(ref_raw, ANALYSIS_SIDE)
        ref_grain = _thumb(ref_raw, 1024)          # grain measured closer to native res
        tgt_full = _thumb(_load(await target.read()), MAX_SIDE)
        tgt_small = _thumb(tgt_full, ANALYSIS_SIDE)
        out = engine.grade_pair(ref_small, tgt_small, tgt_full,
                                intensity=intensity, tone=tone, color=color,
                                bands=bands, clarity=clarity, sharpen=sharpen,
                                grain=grain, vibe=vibe, warmth=warmth,
                                smoother=smoother, glow=glow, crop=crop,
                                ref_grain_src=ref_grain)
    except Exception as e:  # decode errors, bad params, etc.
        raise HTTPException(status_code=400, detail=f"Could not process: {e}") from e
    return Response(content=_jpeg_bytes(out), media_type="image/jpeg")


@app.post("/api/ai-style")
async def ai_style(reference: UploadFile, target: UploadFile,
                   model: str = Form("gemini-3.1-flash-image-preview"),
                   clarity_boost: bool = Form(True), key: str = Form(""),
                   image_size: str = Form("1K"),
                   restore_detail: bool = Form(True)):
    try:
        ref_small = _thumb(_load(await reference.read()), AI_SIDE)
        tgt_small = _thumb(_load(await target.read()), AI_SIDE)
    except Exception as e:
        raise HTTPException(status_code=400, detail=f"Could not read images: {e}") from e
    try:
        png = await gemini.style_match(
            _jpeg_bytes(ref_small, 90), _jpeg_bytes(tgt_small, 90),
            model=model, clarity_boost=clarity_boost, key=key,
            image_size=image_size)
    except gemini.GeminiError as e:
        raise HTTPException(status_code=400, detail=str(e)) from e
    if restore_detail:                       # put the original micro-texture back
        try:
            ai = _load(png)
            h, w = ai.shape[:2]
            tgt_rs = np.asarray(Image.fromarray(tgt_small).resize((w, h), Image.LANCZOS))
            ai = engine.detail_restore(ai, tgt_rs)
            buf = io.BytesIO()
            Image.fromarray(ai).save(buf, "PNG")
            png = buf.getvalue()
        except Exception:
            pass                             # restore is best-effort; return raw AI image
    return Response(content=png, media_type="image/png")


@app.post("/api/recipe-style")
async def recipe_style(reference: UploadFile, target: UploadFile,
                       intensity: int = Form(100), crop: str = Form(""),
                       key: str = Form("")):
    """Style ANALYSIS (vision model) -> parametric recipe -> deterministic apply.
    The target's pixels are adjusted, never regenerated: full pixel clarity."""
    try:
        ref_small = _thumb(_load(await reference.read()), AI_SIDE)
        tgt_full = _thumb(_load(await target.read()), MAX_SIDE)
    except Exception as e:
        raise HTTPException(status_code=400, detail=f"Could not read images: {e}") from e
    try:
        import analyst
        recipe = await analyst.analyze(_jpeg_bytes(ref_small, 90), key=key)
    except gemini.GeminiError as e:
        raise HTTPException(status_code=400, detail=str(e)) from e
    out = engine.apply_recipe(tgt_full, recipe, intensity=intensity)
    if crop == "phi":
        out = engine.phi_crop(out)
    recipe_b64 = base64.b64encode(json.dumps(recipe).encode()).decode()
    return Response(content=_jpeg_bytes(out), media_type="image/jpeg",
                    headers={"X-Recipe-B64": recipe_b64})


app.mount("/", StaticFiles(directory="static", html=True), name="static")
